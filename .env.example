# Copy to .env and fill in. .env is git-ignored.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Google Safe Browsing API v4 key (free): https://developers.google.com/safe-browsing/v4/get-started
SAFE_BROWSING_API_KEY=

# Optional. Without it an in-memory cache is used.
REDIS_URL=

# Hugging Face write token for deploying the Space: https://huggingface.co/settings/tokens
HF_TOKEN=
